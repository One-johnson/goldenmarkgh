# Payload
PAYLOAD_SECRET=replace-with-a-long-random-string

# Neon Postgres (use the pooled connection string from the Neon console)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Optional. Public site URL for metadata/sitemap
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. Free contact-form delivery via https://web3forms.com
# Without this key, submissions still succeed in demo mode (logged server-side only).
WEB3FORMS_ACCESS_KEY=
