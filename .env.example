# Payload
PAYLOAD_SECRET=replace-with-a-long-random-string

# Neon Postgres (use the pooled connection string from the Neon console)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full

# Optional. Public site URL for metadata/sitemap
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form — Namecheap Private Email (SMTP) via nodemailer (recommended)
# Use one authenticated mailbox to send; the form routes TO the department inbox.
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@yourdomain.com
# SMTP_PASS=your-mailbox-password
# SMTP_FROM="Goldenmark Ghana <info@yourdomain.com>"
# CONTACT_CC_INFO=true

# Optional fallback until SMTP is configured
# WEB3FORMS_ACCESS_KEY=
